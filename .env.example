# Copy to .env before running docker compose.
#
#   cp .env.example .env
#   ENCRYPTION_KEY=$(openssl rand -base64 32)
#
# ENCRYPTION_KEY is required. It encrypts webhook URLs and IP allow-lists at
# rest; it does NOT encrypt secrets, which are end-to-end encrypted in the
# browser and unreadable by the server either way. Compose refuses to start
# without it rather than falling back to a well-known development key.
ENCRYPTION_KEY=

NODE_ENV=production
SERVER_PORT=4321
WEB_PORT=8125
# Public URL of the API, baked into the web bundle at build time. Changing it
# requires `docker compose up --build`.
API_URL=http://localhost:4321

# --- Redis ---
# Only inline secrets live in Redis; a streamed payload costs ~0.4 KB there
# regardless of size. Give the container roughly double this in real memory —
# RDB snapshots fork, and copy-on-write can approach 2x during the write.
REDIS_MAXMEMORY=4gb

# --- branding (build time; requires --build to change) ---
# Shown in the header and the browser tab.
APP_NAME=CyberForce Crypt

# --- password policy (build time; requires --build to change) ---
REQUIRE_PASSWORD=true
PASSWORD_MIN_LENGTH=5

# --- large payloads (docker-compose.s3.yaml, --profile blob) ---
# Files above the 128 KiB inline threshold go to object storage instead of Redis.
BLOB_STORAGE_ENABLED=true
# Retain stored objects after their link is burned. Off keeps the ephemeral
# guarantee in SPECIFICATION.md.
ALLOW_PERSISTENCE=true
S3_BUCKET=crypt-secrets
S3_ACCESS_KEY_ID=crypt
S3_SECRET_ACCESS_KEY=crypt-secret
# Fallback only. The UI asks the API (GET /config) what it actually accepts,
# so this matters solely when that call fails.
VITE_MAX_FILE_SIZE=2147483648 # 2GB
