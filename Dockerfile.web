FROM node:26-alpine AS build

WORKDIR /app

# Node 25+ no longer bundles Corepack; pin it so pnpm still comes from packageManager.
RUN npm install -g corepack@0.36.0 && corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./

COPY packages/ ./packages/
RUN find packages -type f ! -name "package.json" -delete

RUN pnpm install --frozen-lockfile

COPY . .

RUN pnpm build --filter @crypt.fyi/web

FROM nginx:alpine

COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY nginx/variables.conf.template /etc/nginx/templates/00-variables.conf.template
# API_URL is read at container start (see /config.js in nginx.conf), not baked into the bundle.
COPY --chmod=0755 nginx/10-validate-api-url.sh /docker-entrypoint.d/10-validate-api-url.sh

COPY --from=build /app/packages/web/dist /var/www/html
