    "@typescript-eslint/parser": "8.41.0",
    "chrome-webstore-upload-cli": "4.0.1",
    "concurrently": "9.2.1",
    "eslint": "9.39.2",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "turbo": "2.9.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.17.0",
