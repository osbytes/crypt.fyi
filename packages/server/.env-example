PORT=4321
SHUTDOWN_TIMEOUT_MS=30000
HEALTH_CHECK_ENDPOINT=/health
NODE_ENV=production
LOG_LEVEL=info
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_HEADERS={"Authorization":"Bearer secret-token"}
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW=1m
VAULT_ENTRY_TTL_MS_MIN=
VAULT_ENTRY_TTL_MS_MAX=
VAULT_ENTRY_TTL_MS_DEFAULT=
VAULT_ENTRY_IDENTIFIER_LENGTH=20
VAULT_ENTRY_DELETE_TOKEN_LENGTH=20
BODY_LIMIT_BYTES=50KB
CORS_ORIGIN=localhost:5173
CORS_METHODS=GET,HEAD,POST,DELETE,OPTIONS
CORS_HEADERS=Content-Type,X-Client
ENCRYPTION_KEY=foobar
SERVICE_NAME=
SERVICE_VERSION=
SERVICE_DESCRIPTION=
MAX_IP_RESTRICTIONS=3
MAX_READ_COUNT=10
WEBHOOK_REQUEST_TIMEOUT_MS=3000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_TYPE=exponential
WEBHOOK_BACKOFF_DELAY_MS=5000
WEBHOOK_REMOVE_ON_COMPLETE=true
WEBHOOK_REMOVE_ON_FAIL=true
WEBHOOK_CONCURRENCY=50
WEBHOOK_DRAIN_DELAY_MS=15000
WEBHOOK_STREAM_EVENTS_MAX_LENGTH=100
WEBHOOK_SENDER=
RATE_LIMITER=redis

# --- streamed payloads (object storage) ---
# Enables the >1 MiB path. Leave false to accept inline secrets only.
BLOB_STORAGE_ENABLED=false
BLOB_STORAGE_TYPE=s3
BLOB_KEY_PREFIX=secrets
# Allow a stored object to outlive the link that burned it. Off by default,
# matching the ephemeral guarantee in SPECIFICATION.md.
ALLOW_PERSISTENCE=false
MAX_BLOB_BYTES=2GB
# A part is held in memory while it is relayed; keep at or below any proxy
# body limit (Cloudflare: 100MB).
MAX_UPLOAD_PART_BYTES=16MB
UPLOAD_WINDOW_MS=21600000
S3_BUCKET=
S3_REGION=us-east-1
# Set for MinIO / R2 / any S3-compatible endpoint.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO requires path-style addressing.
S3_FORCE_PATH_STYLE=true
# none | AES256 | aws:kms. Defence in depth only — payloads are already
# end-to-end encrypted. AWS S3 accepts AES256; MinIO needs a KMS configured.
S3_SERVER_SIDE_ENCRYPTION=none
