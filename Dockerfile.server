FROM node:26-alpine AS build

WORKDIR /app

# Node 25+ no longer bundles Corepack; pin it so pnpm still comes from packageManager.
RUN npm install -g corepack@0.36.0 && corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./

COPY packages/ ./packages/
RUN find packages -type f ! -name "package.json" -delete

RUN pnpm install --frozen-lockfile

COPY . .

RUN pnpm build --filter @crypt.fyi/server

FROM node:26-alpine

WORKDIR /app

COPY --from=build /app ./

# Without this the server falls back to development mode, which substitutes a
# hardcoded ENCRYPTION_KEY and skips graceful shutdown.
ENV NODE_ENV=production
ENV PORT=4321
EXPOSE ${PORT}

CMD ["node", "/app/packages/server/dist/index.js"]
