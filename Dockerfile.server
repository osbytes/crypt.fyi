FROM node:22-alpine AS build

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./

COPY packages/ ./packages/
RUN find packages -type f ! -name "package.json" -delete

RUN pnpm install --frozen-lockfile

COPY . .

RUN pnpm build --filter @crypt.fyi/server

# Drop every devDependency and flatten the workspace symlink farm into a
# self-contained tree. Shipping the build stage wholesale carried the compiler,
# the test runner, and all their transitive dependencies into production, which
# is both a large image and a needlessly large attack surface.
RUN pnpm --filter @crypt.fyi/server deploy --prod --legacy \
      --config.strict-peer-dependencies=false /app/bundle


FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4321

COPY --from=build --chown=node:node /app/bundle ./

# `node` ships with the base image and owns nothing outside the app directory.
# Running as root buys nothing here — the process only listens on a socket.
USER node

EXPOSE ${PORT}

CMD ["node", "/app/dist/index.js"]
